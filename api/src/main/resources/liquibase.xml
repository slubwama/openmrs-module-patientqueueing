            <column name="queue_date" type="DATE" />
            <column name="priority_score" type="INT" />
            <column name="priority_reason" type="VARCHAR(255)" />
            <column name="checked_in_at" type="datetime" />
            <column name="called_at" type="datetime" />
            <column name="started_at" type="datetime" />
            <column name="ended_at" type="datetime" />
